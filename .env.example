# Public base URL of this server (used as OAuth2 resource identifier for /mcp).
# Local dev: http://localhost:8000  |  Production: https://your-domain.com
PKTX_PUBLIC_URL=http://localhost:8000
# Clerk configuration — get these from your Clerk dashboard
# https://dashboard.clerk.com → Your App → API Keys
# Note: the JWKS URL and Issuer will be in the format https://<your-clerk-app>.clerk.accounts.dev
CLERK_JWKS_URL=https://<your-clerk-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-app>.clerk.accounts.dev
# Static Clerk OAuth application the MCP DCR proxy uses upstream.
# Create it in the Clerk dashboard with redirect URI <PKTX_PUBLIC_URL>/auth/callback.
CLERK_OAUTH_CLIENT_ID=<clerk-oauth-client-id>
CLERK_OAUTH_CLIENT_SECRET=<clerk-oauth-client-secret>
# Optional: extra redirect-URI patterns for hosted (non-loopback) MCP clients.
# Loopback (http://localhost:*, http://127.0.0.1:*) is always allowed; add an
# entry here only for a hosted client that redirects to its own HTTPS callback.
# Comma-separated, wildcards allowed. ChatGPT needs the entries below: it mints
# a per-connector callback under https://chatgpt.com/connector/oauth/.
# PKTX_EXTRA_CLIENT_REDIRECT_URIS=https://chatgpt.com/connector/oauth/*,https://chatgpt.com/connector_platform_oauth_redirect
# Optional: browser origins whose Clerk session tokens the REST API accepts
# (checked against the token's `azp` claim). Comma-separated. Defaults to the
# origin of PKTX_PUBLIC_URL, which covers `make run` / docker on :8000. Add
# http://localhost:5173 when using the Vite dev server (`cd frontend && make run`),
# otherwise every API call from it returns 401.
# CLERK_AUTHORIZED_PARTIES=http://localhost:8000,http://localhost:5173
# stdio MCP mode only (`pktx --stdio`): the user id tools run as. Required there;
# ignored by the HTTP server.
# PKTX_USER_ID=user_...
# The webhook secret is used to verify that incoming webhooks are actually from Clerk. You can find this in your Clerk dashboard under Webhooks.
CLERK_WEBHOOK_SECRET=whsec_...
# Vite build-time variable — inlined into the frontend JS bundle during Docker build
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...